{
    "name": "performance/api",
    "description": "JSON API of the Performance drink counter",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.30",
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "12.5.44"
    },
    "autoload": {
        "psr-4": {
            "Performance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Performance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
