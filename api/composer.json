{
    "name": "performance/api",
    "description": "JSON API of the Performance drink counter",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "fig/http-message-util": "1.1.5",
        "nikic/fast-route": "1.3.1",
        "psr/container": "2.0.2",
        "psr/http-factory": "1.1.0",
        "psr/http-message": "2.0",
        "psr/http-server-handler": "1.0.2",
        "psr/http-server-middleware": "1.0.2",
        "psr/log": "3.0.2",
        "ralouphie/getallheaders": "3.0.3",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.3"
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.5",
        "phpunit/php-code-coverage": "12.5.8",
        "phpunit/php-file-iterator": "6.0.2",
        "phpunit/php-invoker": "6.0.0",
        "phpunit/php-text-template": "5.0.1",
        "phpunit/php-timer": "8.0.0",
        "phpunit/phpunit": "12.5.44",
        "clue/ndjson-react": "1.3.0",
        "composer/pcre": "3.4.0",
        "composer/semver": "3.6.0",
        "composer/xdebug-handler": "3.0.5",
        "ergebnis/agent-detector": "2.0.0",
        "evenement/evenement": "3.0.2",
        "fidry/cpu-core-counter": "1.4.1",
        "friendsofphp/php-cs-fixer": "3.95.30",
        "myclabs/deep-copy": "1.14.0",
        "nikic/php-parser": "5.9.0",
        "phar-io/manifest": "2.0.4",
        "phar-io/version": "3.2.1",
        "psr/event-dispatcher": "1.0.0",
        "react/cache": "1.2.0",
        "react/child-process": "0.6.7",
        "react/dns": "1.14.0",
        "react/event-loop": "1.6.0",
        "react/promise": "3.3.0",
        "react/socket": "1.17.0",
        "react/stream": "1.4.0",
        "sebastian/cli-parser": "4.2.1",
        "sebastian/comparator": "7.1.8",
        "sebastian/complexity": "5.0.0",
        "sebastian/diff": "7.0.1",
        "sebastian/environment": "8.1.2",
        "sebastian/exporter": "7.0.3",
        "sebastian/global-state": "8.0.3",
        "sebastian/lines-of-code": "4.0.1",
        "sebastian/object-enumerator": "7.0.0",
        "sebastian/object-reflector": "5.0.0",
        "sebastian/recursion-context": "7.0.1",
        "sebastian/type": "6.0.4",
        "sebastian/version": "6.0.2",
        "staabm/side-effects-detector": "1.0.5",
        "symfony/console": "7.4.23",
        "symfony/deprecation-contracts": "3.8.1",
        "symfony/event-dispatcher": "7.4.17",
        "symfony/event-dispatcher-contracts": "3.8.1",
        "symfony/filesystem": "7.4.23",
        "symfony/finder": "7.4.23",
        "symfony/options-resolver": "7.4.22",
        "symfony/polyfill-ctype": "1.37.0",
        "symfony/polyfill-intl-grapheme": "1.43.3",
        "symfony/polyfill-intl-normalizer": "1.43.0",
        "symfony/polyfill-mbstring": "1.43.3",
        "symfony/polyfill-php80": "1.43.0",
        "symfony/polyfill-php81": "1.38.1",
        "symfony/polyfill-php84": "1.43.0",
        "symfony/process": "7.4.22",
        "symfony/service-contracts": "3.8.1",
        "symfony/stopwatch": "7.4.8",
        "symfony/string": "7.4.22",
        "theseer/tokenizer": "2.0.1"
    },
    "autoload": {
        "psr-4": {
            "Performance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Performance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
