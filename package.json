{
  "name": "performance",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm -w web run build",
    "build:preview": "npm -w web run build:preview",
    "build:artifact": "node scripts/build-artifact.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm -w web run typecheck",
    "api:types": "openapi-typescript api/openapi.yaml -o web/src/core/api-client/schema.d.ts && prettier --write web/src/core/api-client/schema.d.ts",
    "check:api-types": "node scripts/check-api-types.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:api-types",
    "test": "vitest run",
    "test:deploy": "vitest run --config vitest.deploy.config.ts",
    "test:e2e": "playwright test",
    "lint:secrets": "git ls-files -z | xargs -0 secretlint --maskSecrets",
    "lint:workflows": "scripts/lint-workflows.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "secretlint": "14.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "yaml": "2.9.1"
  }
}
