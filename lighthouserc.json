{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/zaehlen",
        "http://localhost:8080/rangliste",
        "http://localhost:8080/verwalten",
        "http://localhost:8080/anmelden"
      ],
      "puppeteerScript": "e2e/support/lighthouse-sign-in.cjs",
      "chromePath": "/usr/bin/google-chrome",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      },
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
